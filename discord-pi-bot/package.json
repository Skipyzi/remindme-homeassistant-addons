{
  "name": "remindme",
  "version": "1.0.0",
  "description": "RemindMe: a personal assistant for Home Assistant and Discord",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "lint": "biome check src/",
    "test": "node --test --import tsx test/*.test.ts test/*.test.mjs",
    "format": "biome format --write src/",
    "test:agents": "pnpm build && node test/agents-smoke.cjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "2.1.288",
    "@anthropic-ai/sdk": "^1.3.0",
    "@earendil-works/pi-coding-agent": "0.80.6",
    "@openai/codex": "0.160.0",
    "@xterm/xterm": "6.0.0",
    "dayjs": "^1.11.21",
    "discord.js": "^14.26.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jose": "^6.2.13",
    "openai": "7.45.0",
    "opencode-ai": "1.18.34",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/proper-lockfile": "^4.1.4",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
