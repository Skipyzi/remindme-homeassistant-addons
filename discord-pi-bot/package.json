{
  "name": "remindme",
  "version": "1.0.0",
  "description": "RemindMe: a personal assistant for Home Assistant and Discord",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "lint": "biome check src/",
    "test": "node --test --import tsx test/*.test.ts test/*.test.mjs",
    "format": "biome format --write src/"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "dayjs": "^1.11.21",
    "discord.js": "^14.26.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "openai": "7.45.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
