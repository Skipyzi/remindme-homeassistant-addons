{
  "id": "terrain-generation",
  "name": "Terrain Generation",
  "description": "For Chunky pre-generation runs: players are kept out through maintenance mode, view and simulation distance are minimal, and the chunk pipeline is given the room the generator needs.",
  "knobs": {
    "view_distance": 4,
    "simulation_distance": 3,
    "max_players": 1,
    "whitelist": true,
    "activation_range_animals": 8,
    "activation_range_monsters": 8,
    "activation_range_misc": 4,
    "mob_spawn_range": 2,
    "spawn_limit_monsters": 5,
    "spawn_limit_animals": 2,
    "spawn_limit_ambient": 0,
    "chunk_send_rate": 10,
    "chunk_load_rate": 40,
    "max_concurrent_chunk_generates": 4,
    "max_auto_save_chunks_per_tick": 24,
    "autosave_ticks": 12000,
    "sync_chunk_writes": false
  },
  "settings": {
    "memory_min_mb": 2048,
    "memory_max_mb": 3584,
    "jvm_flags_profile": "performance",
    "maintenance_mode": true
  }
}
